<Application x:Class="TreeSizeBetter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TreeSizeBetter.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:ColdnessToBrushConverter x:Key="ColdBrush" />
            <local:ShareToWidthConverter x:Key="ShareToWidth" />
            <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
