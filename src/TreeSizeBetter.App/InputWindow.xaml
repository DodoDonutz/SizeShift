<Window x:Class="TreeSizeBetter.App.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TreeSizeBetter.App.Shell"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg0}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="ValueBox" Padding="6,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T common.cancel}" IsCancel="True" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="{loc:T input.create}" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="18,6" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
