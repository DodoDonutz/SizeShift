<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ Palette: Hell
         Kuehles Hellgrau mit weissen Flaechen, gleicher Akzentverlauf wie im
         dunklen Modus. Zustandsfarben sind dunkler, damit sie auf Weiss lesbar
         bleiben. Gleiche Schluessel wie Palette.Dark.xaml. -->
    <Color x:Key="Bg0Color">#F3F4F7</Color>
    <Color x:Key="Bg1Color">#FFFFFF</Color>
    <Color x:Key="Bg2Color">#F0F2F6</Color>
    <Color x:Key="Bg3Color">#E4E8EF</Color>
    <Color x:Key="BorderColor">#D6DBE3</Color>
    <Color x:Key="FgColor">#1B1F27</Color>
    <Color x:Key="AccentColor">#3D63F0</Color>
    <Color x:Key="AccentStartColor">#4F7CFF</Color>
    <Color x:Key="AccentEndColor">#9A6BFF</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="FgDim" Color="#5A6373" />
    <SolidColorBrush x:Key="FgFaint" Color="#9AA2AF" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="#D5DEFF" />
    <SolidColorBrush x:Key="Warning" Color="#C2731A" />
    <SolidColorBrush x:Key="Danger" Color="#D2412F" />

    <!-- Zustandsfarben fuer Text und Abzeichen -->
    <SolidColorBrush x:Key="OkText" Color="#1E8752" />
    <SolidColorBrush x:Key="WarnText" Color="#9A6A00" />
    <SolidColorBrush x:Key="BadText" Color="#C3343B" />
    <SolidColorBrush x:Key="WarnBoxBg" Color="#FFF6E2" />
    <SolidColorBrush x:Key="WarnBoxBorder" Color="#F0D59A" />
    <SolidColorBrush x:Key="WarnBoxText" Color="#5A4318" />

    <!-- Flaechen-Details -->
    <SolidColorBrush x:Key="AltRow" Color="#F7F8FB" />
    <SolidColorBrush x:Key="HoverGlow" Color="#0F000000" />
    <SolidColorBrush x:Key="RingTrack" Color="#1F000000" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#C4CAD4" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A3ABB8" />
    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#3D63F0" />

    <!-- Ecke zwischen den Scrollbalken und andere Systemflaechen -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Bg1Color}" />

    <!-- Kacheldiagramm -->
    <SolidColorBrush x:Key="TreemapBg" Color="#E9ECF1" />
    <SolidColorBrush x:Key="TreemapHeaderText" Color="#1B1F27" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3F6CF0" Offset="0" />
        <GradientStop Color="#8A5BF0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2B544" Offset="0" />
        <GradientStop Color="#EC7F3A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7F50" Offset="0" />
        <GradientStop Color="#E8384F" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AmbientGlow">
        <GradientStop Color="#204F7CFF" Offset="0" />
        <GradientStop Color="#0C9A6BFF" Offset="0.55" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="ColdHot" Color="#E2533F" />
    <SolidColorBrush x:Key="ColdWarm" Color="#E38D35" />
    <SolidColorBrush x:Key="ColdCool" Color="#C2A93A" />
    <SolidColorBrush x:Key="ColdCold" Color="#3A97D6" />
    <SolidColorBrush x:Key="ColdFrozen" Color="#6560E0" />
    <SolidColorBrush x:Key="ColdUnknown" Color="#B5BCC7" />

    <LinearGradientBrush x:Key="BarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4F7CFF" Offset="0" />
        <GradientStop Color="#9A6BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TreeBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3A4F7CFF" Offset="0" />
        <GradientStop Color="#309A6BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TreeBarSelected" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#704F7CFF" Offset="0" />
        <GradientStop Color="#609A6BFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
