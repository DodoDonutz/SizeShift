<Window x:Class="TreeSizeBetter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TreeSizeBetter.App.Shell"
        xmlns:vm="clr-namespace:TreeSizeBetter.App.ViewModels"
        xmlns:an="clr-namespace:TreeSizeBetter.Core.Analysis;assembly=TreeSizeBetter.Core"
        xmlns:off="clr-namespace:TreeSizeBetter.Core.Offload;assembly=TreeSizeBetter.Core"
        xmlns:sys="clr-namespace:TreeSizeBetter.Core.SystemInfo;assembly=TreeSizeBetter.Core"
        xmlns:controls="clr-namespace:TreeSizeBetter.App.Controls"
        Title="{Binding WindowTitle}" Height="860" Width="1560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource Bg0}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TreemapRow" Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================ Kopfzeile -->
        <StackPanel Grid.Row="0">
        <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
            <!-- Logo und Schriftzug -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                <Image Source="{StaticResource LogoImage}" Width="24" Height="24" Margin="0,0,9,0" />
                <TextBlock Text="Size" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Shift" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16"
                           FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentGradient}" />
            </StackPanel>

            <!-- Hauptbereiche: jeder mit eigener Werkzeugleiste und eigenem Inhalt -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                <RadioButton Style="{StaticResource AreaTab}" GroupName="Area" IsChecked="{Binding IsAnalyse, Mode=TwoWay}"
                             Tag="&#xE9D9;" Content="{loc:T area.analysis}" />
                <RadioButton Style="{StaticResource AreaTab}" GroupName="Area" IsChecked="{Binding IsCleanup, Mode=TwoWay}"
                             Tag="&#xE74D;" Content="{loc:T area.cleanup}" />
                <RadioButton Style="{StaticResource AreaTab}" GroupName="Area" IsChecked="{Binding IsRelocate, Mode=TwoWay}"
                             Tag="&#xE8AB;" Content="{loc:T area.relocate}" />
                <RadioButton Style="{StaticResource AreaTab}" GroupName="Area" IsChecked="{Binding IsSystem, Mode=TwoWay}"
                             Tag="&#xE7F4;" Content="{loc:T area.system}" />
            </StackPanel>

            <!-- Admin-Modus: ohne Rechte ein Knopf zum Neustart, mit Rechten ein Abzeichen. -->
            <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Command="{Binding RestartAsAdminCommand}" Padding="10,5"
                        Visibility="{Binding IsNotElevated, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{loc:T admin.restart.tip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource WarnText}" />
                        <TextBlock Text="{loc:T admin.restart}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border CornerRadius="10" Padding="10,4" Background="#332F9E6B" BorderBrush="#5537C47F" BorderThickness="1"
                        Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{loc:T admin.active.tip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{DynamicResource OkText}" />
                        <TextBlock Text="{loc:T admin.active}" VerticalAlignment="Center" Foreground="{DynamicResource OkText}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Einstellungen: Darstellung (hell/dunkel) und Spalten der Detailtabelle -->
            <Button DockPanel.Dock="Right" x:Name="SettingsButton" Click="Settings_Click" Padding="9,5"
                    VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{loc:T settings.tip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{loc:T settings.title}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border />
            </DockPanel>
        </Border>

        <!-- Werkzeugleiste der Analyse: eigene Zeile unter den Bereichen -->
        <Border Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,7"
                Visibility="{Binding IsAnalyse, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Wie bei TreeSize: ein Knopf mit Menue - Laufwerke, Dokumente und Cloud,
                     zuletzt untersucht, eigenes Verzeichnis. Auswahl startet den Scan. -->
                <Button Grid.Column="0" x:Name="ChooseRootButton" Click="ChooseRoot_Click" Margin="0,0,10,0"
                        IsEnabled="{Binding IsIdle}" Style="{StaticResource PrimaryButton}" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource WarnText}" />
                        <TextBlock Text="{loc:T root.choose}" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                   VerticalAlignment="Center" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1" Text="{Binding SelectedRoot}" FontFamily="Consolas" FontSize="12.5"
                           VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="360"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgDim}" />

                <Button Grid.Column="3" Content="{loc:T common.refresh}" Command="{Binding ScanCommand}" Margin="0,0,6,0"
                        ToolTip="{loc:T analysis.refresh.tip}" />

                <Button Grid.Column="4" Content="{loc:T common.cancel}" Command="{Binding CancelCommand}" Margin="0,0,16,0" />

                <Button Grid.Column="5" Content="{loc:T export.button}" Click="Export_Click" Margin="0,0,16,0"
                        IsEnabled="{Binding CanExport}"
                        ToolTip="{loc:T export.button.tip}">
                    <Button.ContextMenu>
                        <!-- Ein Kontextmenue haengt nicht im Baum des Fensters, deshalb muss
                             der Datenkontext ueber das Ziel geholt werden. -->
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                   RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{loc:T export.xlsx}" Command="{Binding ExportCommand}" CommandParameter="xlsx"
                                      InputGestureText="{Binding ExportHintXlsx}" ToolTip="{loc:T export.xlsx.tip}" />
                            <MenuItem Header="{loc:T export.csv}" Command="{Binding ExportCommand}" CommandParameter="csv"
                                      InputGestureText="{Binding ExportHintCsv}" ToolTip="{loc:T export.csv.tip}" />
                            <MenuItem Header="{loc:T export.json}" Command="{Binding ExportCommand}" CommandParameter="json"
                                      InputGestureText="{Binding ExportHintJson}" ToolTip="{loc:T export.json.tip}" />
                            <Separator />
                            <MenuItem Header="{loc:T export.ai}" Command="{Binding ExportCommand}" CommandParameter="ki"
                                      InputGestureText="{Binding ExportHintAi}" ToolTip="{loc:T export.ai.tip}" />
                            <Separator />
                            <MenuItem Header="{loc:T export.showLast}" Command="{Binding OpenExportFolderCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource FgDim}" />
                    <ProgressBar IsIndeterminate="True" Margin="0,5,0,0" Height="3"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>

        <!-- ================================================ Warnhinweise -->
        <Border Grid.Row="1" Margin="10,8,10,2" CornerRadius="10" Padding="14,9"
                Background="{DynamicResource WarnBoxBg}" BorderBrush="{DynamicResource WarnBoxBorder}" BorderThickness="1"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Warning}"
                           Margin="0,1,12,0" VerticalAlignment="Top" />
                <DockPanel Grid.Column="1">
                    <Button DockPanel.Dock="Right" Content="{loc:T stale.rescan}" Command="{Binding ScanCommand}" Padding="10,2" Margin="12,-2,0,-2"
                            VerticalAlignment="Center"
                            Visibility="{Binding WarningOffersRescan, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{loc:T stale.rescan.tip}" />
                    <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarnBoxText}" TextWrapping="Wrap" LineHeight="18"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="6,2" Margin="12,-2,0,0"
                        VerticalAlignment="Top" Command="{Binding DismissWarningCommand}" ToolTip="{loc:T stale.hide.tip}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource FgDim}" />
                </Button>
            </Grid>
        </Border>

        <!-- ================================================ Inhalt -->
        <Grid Grid.Row="2" x:Name="ContentArea">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- Ordnerbaum -->
            <Border Grid.Column="0" Background="{DynamicResource Bg1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource Bg2}" Padding="12,5"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="{loc:T tree.folders}" Style="{StaticResource Heading}" VerticalAlignment="Center" />

                            <!-- Modus wie bei TreeSize: wonach Balken, Zahl und Sortierung gehen -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{loc:T tree.barsBy}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="{loc:T mode.size}"
                                             IsChecked="{Binding IsModeSize, Mode=TwoWay}"
                                             ToolTip="{loc:T mode.size.tip}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="{loc:T mode.onDisk}"
                                             IsChecked="{Binding IsModeSizeOnDisk, Mode=TwoWay}"
                                             ToolTip="{loc:T mode.onDisk.tip}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="{loc:T mode.files}"
                                             IsChecked="{Binding IsModeFileCount, Mode=TwoWay}"
                                             ToolTip="{loc:T mode.files.tip}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="%"
                                             IsChecked="{Binding IsModePercent, Mode=TwoWay}"
                                             ToolTip="{loc:T mode.percent.tip}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="1" x:Name="FolderTree" ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonUp="FolderTree_PreviewMouseRightButtonUp"
                              Padding="4,6">
                        <TreeView.Resources>
                            <!--
                                Zeile wie bei TreeSize: Balken hinter dem Namen, proportional zum
                                Anteil am Elternordner, darauf links der Wert und dann der Name.
                                Rechts daneben, buendig untereinander, der belegte Platz.
                            -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
                                <Grid Height="20" ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <Grid x:Name="BarHost" Grid.Column="0" Margin="0,1,8,1">
                                        <Border x:Name="Bar" HorizontalAlignment="Left" CornerRadius="3"
                                                Background="{DynamicResource TreeBar}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="0" />
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource GrowIn}" />
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ShareToWidth}">
                                                    <Binding ElementName="BarHost" Path="ActualWidth" />
                                                    <Binding Path="Share" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>

                                        <Grid Margin="5,0,4,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" MinWidth="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nutzungs-Punkt: Farbe = wie lange zuletzt benutzt -->
                                            <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                                    Margin="0,0,7,0" VerticalAlignment="Center"
                                                    Background="{Binding Coldness, Converter={StaticResource ColdBrush}}" />

                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" Margin="0,0,9,0" />

                                            <TextBlock x:Name="NameText" Grid.Column="2" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding SizeOnDiskText}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,6,0"
                                               Foreground="{DynamicResource FgDim}"
                                               FontFamily="Consolas" FontSize="11.5" />
                                </Grid>

                                <HierarchicalDataTemplate.Triggers>
                                    <!-- Sammelknoten "[N Dateien]" gedaempft, wie bei TreeSize -->
                                    <DataTrigger Binding="{Binding IsFileBucket}" Value="True">
                                        <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource FgDim}" />
                                        <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TreeBarSelected}" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" />

            <!-- Rechte Seite -->
            <TabControl Grid.Column="2" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

                <!-- ===================================== Detailtabelle -->
                <TabItem Header="{loc:T tab.details}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Pfad der Auswahl -->
                        <Border Grid.Row="0" Background="{DynamicResource Bg2}" Padding="12,4,8,4"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedPathText}" FontFamily="Consolas" FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />
                                <!-- Spaltenauswahl: welche Spalten die Tabelle zeigt (auch per Rechtsklick auf die Kopfzeile) -->
                                <Button Grid.Column="1" x:Name="ColumnsButton" Click="Columns_Click" Padding="9,3" Margin="12,0,0,0"
                                        ToolTip="{loc:T columns.tip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock x:Name="ColumnsButtonText" Text="{loc:T columns.button}" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   VerticalAlignment="Center" Margin="7,1,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Filterleiste -->
                        <Border Grid.Row="1" Background="{DynamicResource Bg1}" Padding="12,8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="{loc:T filter.flat}" IsChecked="{Binding Recursive}"
                                          Margin="0,0,18,0"
                                          ToolTip="{loc:T filter.flat.tip}" />

                                <TextBlock Text="{loc:T filter.from}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="58" Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:T filter.minMb.tip}" />
                                <TextBlock Text="{loc:T filter.mb}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="5,0,16,0" />

                                <TextBlock Text="{loc:T filter.unusedFor}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="58" Text="{Binding MinAgeText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:T filter.days.tip}" />
                                <TextBlock Text="{loc:T filter.days}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="5,0,16,0" />

                                <TextBlock Text="{loc:T filter.nameLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="130" Margin="0,0,16,0"
                                         Text="{Binding NameFilterText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="{loc:T filter.extLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="130" Margin="0,0,16,0"
                                         Text="{Binding ExtensionFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:T filter.ext.tip}" />

                                <ComboBox Width="150" Margin="0,0,16,0" ItemsSource="{Binding KindOptions}"
                                          SelectedIndex="{Binding KindIndex}" />

                                <CheckBox Content="{loc:T filter.noLinks.label}" IsChecked="{Binding ExcludeLinks}"
                                          Margin="0,0,16,0"
                                          ToolTip="{loc:T filter.noLinks.tip}" />

                                <Button Content="{loc:T filter.clear}" Command="{Binding ResetFiltersCommand}" Padding="10,3" />
                            </WrapPanel>
                        </Border>

                        <!-- Tabelle -->
                        <DataGrid Grid.Row="2" x:Name="DetailGrid" ItemsSource="{Binding Rows}"
                                  CanUserSortColumns="True" Sorting="DetailGrid_Sorting"
                                  MouseDoubleClick="DetailGrid_MouseDoubleClick"
                                  PreviewMouseRightButtonUp="DetailGrid_PreviewMouseRightButtonUp">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                </Style>
                            </DataGrid.RowStyle>


                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:T grid.name}" Width="300" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,7,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Coldness, Converter={StaticResource ColdBrush}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{loc:T grid.type}" Binding="{Binding TypeText}" Width="132"
                                                    SortMemberPath="Extension" />

                                <DataGridTextColumn Header="{loc:T grid.size}" Binding="{Binding SizeText}" Width="92"
                                                    SortMemberPath="Size"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    CellStyle="{StaticResource NumericCell}" />

                                <DataGridTemplateColumn Header="{loc:T grid.share}" Width="120" SortMemberPath="Share">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                                    <Border Height="8" Width="70" HorizontalAlignment="Left"
                                                            Background="{DynamicResource Bg3}" CornerRadius="4" />
                                                    <Border Height="8" Width="{Binding BarWidth}" HorizontalAlignment="Left"
                                                            Background="{DynamicResource BarBrush}" CornerRadius="4"
                                                            RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="0" />
                                                        </Border.RenderTransform>
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard Storyboard="{StaticResource GrowIn}" />
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding ShareText}" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{loc:T grid.onDisk}" Binding="{Binding SizeOnDiskText}" Width="88"
                                                    SortMemberPath="SizeOnDisk"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    CellStyle="{StaticResource NumericCell}" />

                                <DataGridTextColumn Header="{loc:T grid.files}" Binding="{Binding FileCountText}" Width="76"
                                                    SortMemberPath="FileCount"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    CellStyle="{StaticResource NumericCell}" />

                                <DataGridTextColumn Header="{loc:T grid.folders}" Binding="{Binding DirCountText}" Width="70"
                                                    SortMemberPath="DirCount"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    CellStyle="{StaticResource NumericCell}" />

                                <DataGridTemplateColumn Header="{loc:T grid.lastUsed}" Width="132" SortMemberPath="ColdDays">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="4" Height="13" CornerRadius="1" Margin="0,0,7,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Coldness, Converter={StaticResource ColdBrush}}" />
                                                <TextBlock Text="{Binding ColdText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{loc:T grid.lastModified}" Binding="{Binding ModifiedDaysText}" Width="132"
                                                    SortMemberPath="ModifiedDays"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    CellStyle="{StaticResource NumericCell}" />

                                <DataGridTextColumn Header="{loc:T grid.lastOpened}" Binding="{Binding AccessedDaysText}" Width="132"
                                                    SortMemberPath="AccessedDays"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    CellStyle="{StaticResource NumericCell}" />

                                <DataGridTextColumn Header="{loc:T grid.modifiedOn}" Binding="{Binding ModifiedText}" Width="128"
                                                    SortMemberPath="Modified" />

                                <DataGridTextColumn Header="{loc:T grid.accessedOn}" Binding="{Binding AccessedText}" Width="132"
                                                    SortMemberPath="Accessed" />

                                <DataGridTextColumn Header="{loc:T grid.createdOn}" Binding="{Binding CreatedText}" Width="124"
                                                    SortMemberPath="Created" />

                                <DataGridTextColumn Header="{loc:T grid.depth}" Binding="{Binding Depth}" Width="56"
                                                    SortMemberPath="Depth"
                                                    HeaderStyle="{StaticResource RightHeader}"
                                                    CellStyle="{StaticResource NumericCell}" />

                                <DataGridTextColumn Header="{loc:T grid.attributes}" Binding="{Binding AttributeText}" Width="150" />

                                <DataGridTextColumn Header="{loc:T grid.path}" Binding="{Binding FullPath}" Width="500" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Fusszeile der Tabelle -->
                        <Border Grid.Row="3" Background="{DynamicResource Bg2}" Padding="12,6"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock Text="{Binding RowSummary}" Foreground="{DynamicResource FgDim}" />
                                <TextBlock Text="{loc:T common.calculating}" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"
                                           Visibility="{Binding IsQuerying, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===================================== Uebersicht -->
                <TabItem Header="{loc:T tab.overview}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasOverview, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer.Resources>
                            <!-- Karte im Dashboard -->
                            <Style x:Key="DashCard" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Bg1}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="14" />
                                <Setter Property="Padding" Value="20,16" />
                            </Style>
                            <!-- Anklickbare Listenzeile: springt im Baum an die Stelle -->
                            <Style x:Key="ListRow" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>

                        <StackPanel DataContext="{Binding Overview}" Margin="22,18,22,24" MaxWidth="1240" HorizontalAlignment="Left">

                            <!-- ============ Kopf: Laufwerk mit Ring und Kennzahlen -->
                            <Border Style="{StaticResource DashCard}" Padding="24,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="120" Height="120">
                                        <controls:UsageRing Target="{Binding VolumeUsedShare}" Thickness="11"
                                                            TrackBrush="{DynamicResource RingTrack}"
                                                            FillBrush="{DynamicResource AccentGradient}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="24" FontWeight="SemiBold"
                                                       Text="{Binding VolumeUsedShare, StringFormat={}{0:P0}}" />
                                            <TextBlock Text="{loc:T overview.used}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="24,0,40,0" VerticalAlignment="Center" MaxWidth="360">
                                        <TextBlock Text="{Binding RootPath}" Style="{StaticResource Display}" FontSize="28"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding VolumeText}" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Margin="10,4" MinWidth="140">
                                            <TextBlock Text="{loc:T overview.onDisk}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding OnDiskText}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentGradient}" />
                                        </StackPanel>
                                        <StackPanel Margin="10,4" MinWidth="140">
                                            <TextBlock Text="{loc:T overview.logical}" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                                       ToolTip="{loc:T overview.logical.tip}" />
                                            <TextBlock Text="{Binding TotalText}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="26" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="10,4" MinWidth="140">
                                            <TextBlock Text="{loc:T overview.files}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FileCountText}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="26" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="10,4" MinWidth="140">
                                            <TextBlock Text="{loc:T overview.folders}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DirectoryCountText}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="26" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- ============ Zwei Spalten: Alter und Dateitypen -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T overview.age.title}" Style="{StaticResource Heading}" FontSize="15" />
                                        <TextBlock Text="{loc:T overview.age.text}"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,12" />
                                        <ItemsControl ItemsSource="{Binding AgeByWrite}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type an:AgeBreakdownRow}">
                                                    <Grid Height="28">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="230" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                                            <Border Height="10" Width="220" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource Bg3}" CornerRadius="5" />
                                                            <Border Height="10" Width="{Binding BarWidth}" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource BarBrush}" CornerRadius="5"
                                                                    RenderTransformOrigin="0,0.5">
                                                                <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                                                <Border.Triggers>
                                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                        <BeginStoryboard Storyboard="{StaticResource GrowIn}" />
                                                                    </EventTrigger>
                                                                </Border.Triggers>
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BytesText}" FontWeight="SemiBold" MinWidth="70" />
                                                            <TextBlock Text="{Binding ShareText}" Foreground="{DynamicResource FgDim}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T overview.types.title}" Style="{StaticResource Heading}" FontSize="15" />
                                        <TextBlock Text="{loc:T overview.types.text}"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,12" />
                                        <ItemsControl ItemsSource="{Binding Types}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type an:TypeBreakdownRow}">
                                                    <Grid Height="28">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="230" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Consolas" />
                                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                                            <Border Height="10" Width="220" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource Bg3}" CornerRadius="5" />
                                                            <Border Height="10" Width="{Binding BarWidth}" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource BarBrush}" CornerRadius="5"
                                                                    RenderTransformOrigin="0,0.5">
                                                                <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                                                <Border.Triggers>
                                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                        <BeginStoryboard Storyboard="{StaticResource GrowIn}" />
                                                                    </EventTrigger>
                                                                </Border.Triggers>
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BytesText}" FontWeight="SemiBold" MinWidth="70" />
                                                            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource FgDim}" />
                                                            <TextBlock Text="{loc:T overview.filesSuffix}" Foreground="{DynamicResource FgDim}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ============ Groß und lange unbenutzt -->
                            <Border Style="{StaticResource DashCard}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T overview.cold.title}" Style="{StaticResource Heading}" FontSize="15" />
                                    <TextBlock Text="{loc:T overview.cold.text}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                    <ItemsControl ItemsSource="{Binding ColdestBigFolders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type an:TopEntryRow}">
                                                <Button Style="{StaticResource ListRow}"
                                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Index}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding BytesText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                                   Margin="0,0,16,0" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left"
                                                                Background="#1F5AB0EC" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ColdText}" Foreground="{DynamicResource ColdCold}" FontSize="12" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Path}" Foreground="{DynamicResource FgDim}"
                                                                   FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ============ Größte Dateien -->
                            <Border Style="{StaticResource DashCard}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T overview.largest.title}" Style="{StaticResource Heading}" FontSize="15" />
                                    <TextBlock Text="{loc:T overview.largest.text}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,10" />
                                    <ItemsControl ItemsSource="{Binding LargestFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type an:TopEntryRow}">
                                                <Button Style="{StaticResource ListRow}"
                                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Index}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding BytesText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                                   Margin="0,0,16,0" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" CornerRadius="10" Padding="9,2" HorizontalAlignment="Left"
                                                                Background="{DynamicResource Bg3}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ColdText}" Foreground="{DynamicResource FgDim}" FontSize="12" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Path}" Foreground="{DynamicResource FgDim}"
                                                                   FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>


            </TabControl>
        </Grid>

        <!-- ================================================ Bereich Aufraeumen
             Eigener Bereich ueber dem Analyse-Inhalt. Liegt unter dem Scan-Overlay,
             damit ein Scan von hier aus sichtbar laeuft. -->
        <Grid Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg1}" Panel.ZIndex="5"
              Visibility="{Binding IsCleanup, Converter={StaticResource BoolToVisibility}}">
            <Grid DataContext="{Binding Cleanup}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Kopf: Summe, Auswahl, Aufraeumen -->
                        <Border Grid.Row="0" Background="{DynamicResource Bg1}" Padding="14,12"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SummaryText}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <!-- Laufwerke: anhaken und neu durchsuchen -->
                                    <WrapPanel Margin="0,9,0,0">
                                        <TextBlock Text="{loc:T cleanup.drives}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ItemsControl ItemsSource="{Binding Drives}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CleanupDrive}">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                              ToolTip="{Binding FreeText}">
                                                        <TextBlock>
                                                            <Run Text="{Binding Letter, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource FgDim}" />
                                                        </TextBlock>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Command="{Binding SearchCommand}" Padding="9,3" Margin="4,0,0,0"
                                                ToolTip="{loc:T cleanup.scan.tip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:T cleanup.scan}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,9,0,0">
                                        <TextBlock Text="{loc:T cleanup.select}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="{loc:T cleanup.select.safe}" Command="{Binding SelectSafeCommand}" Padding="9,3" Margin="0,0,5,0" />
                                        <Button Content="{loc:T cleanup.select.all}" Command="{Binding SelectAllCommand}" Padding="9,3" Margin="0,0,5,0" />
                                        <Button Content="{loc:T cleanup.select.none}" Command="{Binding SelectNoneCommand}" Padding="9,3" Margin="0,0,18,0" />
                                        <CheckBox Content="{loc:T cleanup.recycleAll}" IsChecked="{Binding RecycleEverything}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{loc:T cleanup.recycleAll.tip}" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{loc:T common.cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Command="{Binding CleanCommand}" Style="{StaticResource PrimaryButton}" Padding="16,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <TextBlock Text="{Binding CleanButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Funde, groesste zuerst. Bewusst ohne Gruppierung: die verkleinert im
                             DataGrid alle Spalten auf wenige Pixel. -->
                        <DataGrid Grid.Row="1" x:Name="CleanupGrid" ItemsSource="{Binding RowsView}"
                                  SelectedItem="{Binding SelectedRow}" SelectionMode="Single"
                                  MouseDoubleClick="CleanupGrid_MouseDoubleClick"
                                  EnableColumnVirtualization="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:CleanupRow}">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsActionable}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:T cleanup.col.safety}" Width="100" SortMemberPath="Safety">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:CleanupRow}">
                                            <Border x:Name="Badge" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left"
                                                    Background="#2A37C47F">
                                                <TextBlock x:Name="BadgeText" Text="{Binding SafetyText}" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource OkText}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Safety}" Value="{x:Static an:FindingSafety.Vorsichtig}">
                                                    <Setter TargetName="Badge" Property="Background" Value="#2AF2C14E" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource WarnText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Safety}" Value="{x:Static an:FindingSafety.Riskant}">
                                                    <Setter TargetName="Badge" Property="Background" Value="#2AE5484D" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource BadText}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:T cleanup.col.what}" Binding="{Binding Title}" Width="290" />
                                <DataGridTextColumn Header="{loc:T cleanup.col.group}" Binding="{Binding Group}" Width="185" />
                                <DataGridTextColumn Header="{loc:T grid.onDisk}" Binding="{Binding BytesText}" SortMemberPath="Bytes" Width="90"
                                                    HeaderStyle="{StaticResource RightHeader}" CellStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:T cleanup.col.extent}" Binding="{Binding ItemsText}" Width="120"
                                                    HeaderStyle="{StaticResource RightHeader}" CellStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:T cleanup.col.where}" Binding="{Binding WhereText}" Width="175" />
                                <DataGridTextColumn Header="{loc:T cleanup.col.location}" Binding="{Binding Location}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Erklaerung zum gewaehlten Fund, Fortschritt, Ergebnis -->
                        <Border Grid.Row="2" Background="{DynamicResource Bg1}" Padding="14,11"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <StackPanel DataContext="{Binding SelectedRow}"
                                            Visibility="{Binding Title, Converter={StaticResource EmptyToCollapsed}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="13.5" />
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="1100"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Advice, StringFormat={loc:T cleanup.adviceFormat}}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Foreground="{DynamicResource Accent}" MaxWidth="1100" HorizontalAlignment="Left"
                                               Visibility="{Binding Advice, Converter={StaticResource EmptyToCollapsed}}" />
                                    <TextBlock Text="{Binding KeptText}" Foreground="{DynamicResource FgDim}" Margin="0,4,0,0"
                                               Visibility="{Binding KeptText, Converter={StaticResource EmptyToCollapsed}}" />
                                    <TextBlock Text="{loc:T cleanup.systemFolder}"
                                               Foreground="{DynamicResource WarnText}" Margin="0,4,0,0"
                                               Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{loc:T cleanup.doubleClick}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                </StackPanel>

                                <ProgressBar Height="5" Margin="0,10,0,0" Maximum="100"
                                             Value="{Binding ProgressValue, Mode=OneWay}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource FgDim}" Margin="0,4,0,0"
                                           Visibility="{Binding ProgressText, Converter={StaticResource EmptyToCollapsed}}" />
                                <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding ResultText, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </Border>
                    </Grid>

            <!-- Start: Laufwerke anhaken und durchsuchen -->
            <Grid Background="{DynamicResource Bg0}" DataContext="{Binding Cleanup}"
                  Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Accent}" Margin="0,0,0,16" />
                <TextBlock Text="{loc:T cleanup.intro.title}" Style="{StaticResource Display}" FontSize="26"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:T cleanup.intro.text}"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="0,10,0,20" FontSize="14" />
                <ItemsControl ItemsSource="{Binding Drives}" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CleanupDrive}">
                            <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10" Margin="5" MinWidth="190">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalContentAlignment="Center">
                                    <StackPanel Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="18,8"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="{loc:T cleanup.scan}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource WarnText}" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Visibility="{Binding ResultText, Converter={StaticResource EmptyToCollapsed}}" />
            </StackPanel>
            </Grid>

            <!-- Suche laeuft -->
            <Grid Background="{DynamicResource Bg0}" DataContext="{Binding Cleanup}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBusy}" Value="True" />
                                    <Condition Binding="{Binding HasRows}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" FontSize="14" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,14" />
                    <Button Content="{loc:T common.cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Padding="14,5" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================================================ Bereich System
             Uebersicht ueber Hardware und Windows (nur lesend) und der Autostart. -->
        <Grid Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg0}" Panel.ZIndex="5" DataContext="{Binding SystemArea}"
              Visibility="{Binding DataContext.IsSystem, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.Resources>
                <Style x:Key="SysCard" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Bg1}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Padding" Value="18,14" />
                    <Setter Property="Margin" Value="0,0,14,14" />
                    <Setter Property="Width" Value="420" />
                </Style>
                <Style x:Key="SysCardTitle" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </Grid.Resources>

            <TabControl x:Name="SystemTabs" Margin="0">
                <!-- ===================================== Uebersicht -->
                <TabItem Header="{loc:T system.tab.overview}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Bg1}" Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Command="{Binding CancelReportCommand}" Content="{loc:T common.cancel}" Padding="10,4" Margin="0,0,8,0"
                                            Visibility="{Binding IsReporting, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Command="{Binding ReportCommand}" Style="{StaticResource PrimaryButton}" Padding="12,4" Margin="0,0,8,0"
                                            ToolTip="{loc:T report.button.tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{loc:T report.button}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RefreshCommand}" Padding="10,4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{loc:T system.refresh}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CopyCommand}" Padding="10,4" ToolTip="{loc:T system.copy.tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{loc:T system.copy}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ComputerName}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ReportStatus}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="18,0,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="700"
                                               Visibility="{Binding ReportStatus, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,2,0">
                            <WrapPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                                <!-- Windows -->
                                <Border Style="{StaticResource SysCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T system.card.windows}" Style="{StaticResource SysCardTitle}" />
                                        <TextBlock Text="{Binding OsTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OsDetail}" Foreground="{DynamicResource FgDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource FgDim}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <!-- Prozessor -->
                                <Border Style="{StaticResource SysCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T system.card.cpu}" Style="{StaticResource SysCardTitle}" />
                                        <TextBlock Text="{Binding CpuName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CpuDetail}" Foreground="{DynamicResource FgDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <!-- Arbeitsspeicher -->
                                <Border Style="{StaticResource SysCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T system.card.memory}" Style="{StaticResource SysCardTitle}" />
                                        <TextBlock Text="{Binding MemoryText}" FontSize="15" FontWeight="SemiBold" />
                                        <ProgressBar Height="6" Maximum="1" Margin="0,8,0,8" Value="{Binding MemoryShare, Mode=OneWay}" />
                                        <ItemsControl ItemsSource="{Binding MemoryModules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource FgDim}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <!-- Grafikkarten -->
                                <Border Style="{StaticResource SysCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T system.card.gpu}" Style="{StaticResource SysCardTitle}" />
                                        <ItemsControl ItemsSource="{Binding Gpus}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GpuRow}">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource FgDim}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <!-- Laufwerke -->
                                <Border Style="{StaticResource SysCard}" Width="854">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T system.card.disks}" Style="{StaticResource SysCardTitle}" />
                                        <ItemsControl ItemsSource="{Binding Disks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:DiskRow}">
                                                    <StackPanel Margin="0,0,0,12">
                                                        <DockPanel>
                                                            <Border x:Name="Badge" DockPanel.Dock="Right" CornerRadius="9" Padding="9,1" Background="#2A37C47F"
                                                                    ToolTip="{loc:T system.health.tip}">
                                                                <TextBlock x:Name="BadgeText" Text="{Binding HealthText}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource OkText}" />
                                                            </Border>
                                                            <TextBlock FontSize="14" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="   " />
                                                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource FgDim}" FontSize="12" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,6,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:VolumeRow}">
                                                                    <Grid Margin="0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="220" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" />
                                                                        <ProgressBar Grid.Column="1" Height="6" Maximum="1" VerticalAlignment="Center"
                                                                                     Value="{Binding Share, Mode=OneWay}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter TargetName="Badge" Property="Background" Value="#2AF2C14E" />
                                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource WarnText}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBad}" Value="True">
                                                            <Setter TargetName="Badge" Property="Background" Value="#2AE5484D" />
                                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource BadText}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Health}" Value="{x:Static sys:DiskHealth.Unbekannt}">
                                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Bg3}" />
                                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource FgDim}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </ScrollViewer>
                        <TextBlock Grid.Row="1" Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource FgDim}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </TabItem>

                <!-- ===================================== Autostart -->
                <TabItem Header="{loc:T system.tab.startup}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Bg1}" Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshStartupCommand}" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{loc:T system.refresh}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{Binding StartupStatus}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:T startup.explain}" Foreground="{DynamicResource FgDim}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding StartupRows}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:T startup.col.on}" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:AutostartRow}">
                                            <!-- Kaestchen immer an derselben Stelle, das Schloss in einer
                                                 festen Spalte rechts daneben - sonst wirkt eine Zeile eingerueckt. -->
                                            <Grid Margin="10,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="18" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanChange}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource WarnText}"
                                                           ToolTip="{loc:T startup.locked.tip}"
                                                           Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:T startup.col.name}" Binding="{Binding Name}" Width="220" />
                                <DataGridTextColumn Header="{loc:T startup.col.publisher}" Binding="{Binding Publisher}" Width="200" />
                                <DataGridTemplateColumn Header="{loc:T startup.col.state}" Width="110" SortMemberPath="StateText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:AutostartRow}">
                                            <TextBlock x:Name="State" Text="{Binding StateText}" Foreground="{DynamicResource OkText}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource FgDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FileMissing}" Value="True">
                                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource WarnText}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:T startup.col.location}" Binding="{Binding LocationText}" Width="200" />
                                <DataGridTextColumn Header="{loc:T startup.col.command}" Binding="{Binding Command}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Background="{DynamicResource Bg1}" Padding="16,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding HasLockedRows, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource WarnText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T startup.lockedHint}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===================================== Prozesse: Aufzeichnung ueber eine Zeitspanne -->
                <TabItem Header="{loc:T procs.tab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Bg1}" Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProcessCountText}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <CheckBox Content="{loc:T procs.showAll}" IsChecked="{Binding ShowAllProcesses}" ToolTip="{loc:T procs.showAll.tip}"
                                                  VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Button Command="{Binding SaveProcessReportCommand}" Padding="10,4" ToolTip="{loc:T procs.report.tip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{loc:T report.button}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T procs.duration}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding RecordDurations}" SelectedItem="{Binding SelectedDuration}" MinWidth="110" Margin="0,0,10,0"
                                                  IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}" />
                                        <Button Command="{Binding StartRecordCommand}" Style="{StaticResource PrimaryButton}" Padding="12,4" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{loc:T procs.start}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding StopRecordCommand}" Content="{loc:T procs.stop}" Padding="10,4"
                                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding RecordStatus}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="14,0,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar Height="4" Maximum="1" Margin="0,8,0,0" Value="{Binding RecordProgress, Mode=OneWay}"
                                             Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{loc:T procs.adminHint}" Foreground="{DynamicResource FgDim}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding ShowProcessAdminHint, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ProcessRows}" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T procreport.col.program}" Binding="{Binding Name}" Width="230">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Name}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="{loc:T procreport.col.cpuAvg}" Width="140" SortMemberPath="CpuAvg">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Height="6" Maximum="1" VerticalAlignment="Center" Value="{Binding CpuBar, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CpuAvgText}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:T procreport.col.cpuPeak}" Binding="{Binding CpuPeakText}" SortMemberPath="CpuPeak" Width="80"
                                                    HeaderStyle="{StaticResource RightHeader}" CellStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:T procreport.col.ramAvg}" Binding="{Binding RamAvgText}" SortMemberPath="RamAvg" Width="90"
                                                    HeaderStyle="{StaticResource RightHeader}" CellStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:T procreport.col.ramPeak}" Binding="{Binding RamPeakText}" SortMemberPath="RamPeak" Width="90"
                                                    HeaderStyle="{StaticResource RightHeader}" CellStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:T procreport.col.disk}" Binding="{Binding DiskText}" SortMemberPath="Disk" Width="150"
                                                    HeaderStyle="{StaticResource RightHeader}" CellStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:T procreport.col.instances}" Binding="{Binding Instances}" Width="60"
                                                    HeaderStyle="{StaticResource RightHeader}" CellStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:T procreport.col.parent}" Binding="{Binding Parent}" Width="150" />
                                <DataGridTextColumn Header="{loc:T procreport.col.description}" Binding="{Binding Description}" Width="240" />
                                <DataGridTextColumn Header="{loc:T procreport.col.path}" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620"
                                    Visibility="{Binding ShowRecordIntro, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,0,14" />
                            <TextBlock Text="{loc:T procs.intro.title}" Style="{StaticResource Display}" FontSize="22" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:T procs.intro.text}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource FgDim}" Margin="0,10,0,0" FontSize="13.5" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ================================================ Bereich Umlagern
             Links die Quelle (Haekchen), rechts der Zielordner, dazwischen die Pfeile. -->
        <Grid Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg0}" Panel.ZIndex="5" DataContext="{Binding Offload}"
              Visibility="{Binding DataContext.IsRelocate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <!-- Ordnerzeile: Haken, Symbol, Name mit Balken, Groesse rechtsbuendig -->
                <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNode}" ItemsSource="{Binding Children}">
                    <Grid Height="22" x:Name="Row">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                  Margin="0,0,6,0" Focusable="False"
                                  Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock x:Name="Icon" Grid.Column="1" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource WarnText}" VerticalAlignment="Center" Margin="0,0,7,0" />

                        <Grid x:Name="BarHost" Grid.Column="2" Margin="0,2,10,2">
                            <Border x:Name="Bar" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource TreeBar}" Opacity="0.75">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ShareToWidth}">
                                        <Binding ElementName="BarHost" Path="ActualWidth" />
                                        <Binding Path="Share" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="5,0,4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding JunctionText}" Foreground="{DynamicResource Accent}" Margin="10,0,0,0"
                                           FontSize="11.5" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsJunction, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarnText}" Margin="10,0,0,0" FontSize="11.5" FontStyle="Italic"
                                           Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Width="78" TextAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,6,0" Foreground="{DynamicResource FgDim}" FontFamily="Consolas" FontSize="11.5"
                                   Visibility="{Binding ShowSize, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsJunction}" Value="True">
                            <Setter TargetName="Icon" Property="Text" Value="&#xE71B;" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                            <Setter TargetName="Icon" Property="Text" Value="&#xEDA2;" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Accent}" />
                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TreeBarSelected}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>

            </Grid.Resources>

            <Grid Grid.Row="0" Margin="12,12,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ Links: woher -->
                <Border Grid.Column="0" Background="{DynamicResource Bg1}" CornerRadius="10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Bg2}" CornerRadius="10,10,0,0" Padding="12,9"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T relocate.from}" Style="{StaticResource Heading}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Left.Drives}" SelectedItem="{Binding Left.Drive}" MinWidth="215">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DriveChoice}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding FreeText}" Foreground="{DynamicResource FgDim}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Left.DriveSummary}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{loc:T relocate.sort}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="LeftSort" Content="{loc:T relocate.sort.size}"
                                                 IsChecked="{Binding Left.SortBySize, Mode=TwoWay}" ToolTip="{loc:T relocate.sort.size.tip}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="LeftSort" Content="A–Z" Margin="0,0,10,0"
                                                 IsChecked="{Binding Left.SortByName, Mode=TwoWay}" ToolTip="{loc:T relocate.sort.name.tip}" />
                                    <Button x:Name="SuggestionsButton" Click="Suggestions_Click" Padding="9,3" Margin="0,0,6,0"
                                            ToolTip="{loc:T relocate.suggestions.tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE82F;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource WarnText}" />
                                            <TextBlock Text="{loc:T relocate.suggestions}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{loc:T relocate.uncheck}" Command="{Binding UncheckAllCommand}" Padding="9,3" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TreeView Grid.Row="1" ItemsSource="{Binding Left.Roots}" Padding="4,6" Background="Transparent" PreviewMouseRightButtonUp="ExplorerTree_PreviewMouseRightButtonUp" />
                    </Grid>
                </Border>

                <!-- ============ Mitte: Pfeile -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0" Width="150">
                    <Button Command="{Binding RefreshCommand}" Padding="0,6" Margin="0,0,0,28"
                            ToolTip="{loc:T relocate.refresh.tip}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:T common.refresh}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding MoveCommand}" Style="{StaticResource PrimaryButton}" Padding="0,14"
                            ToolTip="{loc:T relocate.go.tip}">
                        <StackPanel>
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:T area.relocate}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding MoveText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
                    <TextBlock Text="{Binding TargetText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"
                               Style="{StaticResource Caption}" />

                    <Button Command="{Binding BackCommand}" Padding="0,10" Margin="0,34,0,0"
                            ToolTip="{loc:T relocate.back.tip}">
                        <StackPanel>
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:T relocate.back}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding BackText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                               Style="{StaticResource Caption}" />

                    <Button Content="{loc:T common.cancel}" Command="{Binding CancelCommand}" Margin="0,30,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- ============ Rechts: wohin -->
                <Border Grid.Column="2" Background="{DynamicResource Bg1}" CornerRadius="10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Bg2}" CornerRadius="10,10,0,0" Padding="12,9"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T relocate.to}" Style="{StaticResource Heading}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Right.Drives}" SelectedItem="{Binding Right.Drive}" MinWidth="215">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DriveChoice}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FgDim}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding FreeText}" Foreground="{DynamicResource FgDim}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Right.DriveSummary}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{loc:T relocate.sort}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RightSort" Content="{loc:T relocate.sort.size}"
                                                 IsChecked="{Binding Right.SortBySize, Mode=TwoWay}" ToolTip="{loc:T relocate.sort.size.tip}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="RightSort" Content="A–Z" Margin="0,0,10,0"
                                                 IsChecked="{Binding Right.SortByName, Mode=TwoWay}" ToolTip="{loc:T relocate.sort.name.tip}" />
                                    <Button Command="{Binding NewFolderCommand}" Padding="9,3"
                                            ToolTip="{loc:T relocate.newFolder.tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:T relocate.newFolder}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TreeView Grid.Row="1" ItemsSource="{Binding Right.Roots}" Padding="4,6" Background="Transparent" PreviewMouseRightButtonUp="ExplorerTree_PreviewMouseRightButtonUp" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Einstellungen, Fortschritt, Ergebnis -->
            <Border Grid.Row="1" Margin="12,10,12,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource Bg1}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{loc:T relocate.originalAfter}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Deletion" Content="{loc:T relocate.toBin}"
                                     IsChecked="{Binding DeleteToRecycleBin, Mode=TwoWay}"
                                     ToolTip="{loc:T relocate.toBin.tip}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Deletion" Content="{loc:T relocate.delete}"
                                     IsChecked="{Binding DeletePermanently, Mode=TwoWay}"
                                     ToolTip="{loc:T relocate.delete.tip}" />
                        <CheckBox Content="{loc:T relocate.fullHash}" IsChecked="{Binding FullHash}" Margin="22,0,0,0"
                                  VerticalAlignment="Center"
                                  ToolTip="{loc:T relocate.fullHash.tip}" />
                    </WrapPanel>
                    <!-- Erklaerung in eigener Zeile, nicht eingequetscht hinter den Optionen -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{loc:T relocate.linkNote}" />
                    </StackPanel>
                    <ProgressBar Height="5" Margin="0,10,0,0" Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource FgDim}" Margin="0,5,0,0"
                               Visibility="{Binding ProgressText, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,7,0,0"
                               Visibility="{Binding ResultText, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- ============ Verlauf (Journal) -->
            <Button Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0" Padding="9,3"
                    Click="OpenDocumentsFolder_Click" Panel.ZIndex="1"
                    ToolTip="{loc:T docs.open.tip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:T docs.open}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Expander Grid.Row="2" Margin="12,8,12,10" Header="{Binding JournalTitle}" Foreground="{DynamicResource Fg}">
                <DataGrid ItemsSource="{Binding Journal}" SelectionMode="Single" Height="200" Margin="0,6,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T journal.col.no}" Binding="{Binding Id}" Width="44" />
                        <DataGridTextColumn Header="{loc:T journal.col.status}" Binding="{Binding StatusText}" Width="130" />
                        <DataGridTextColumn Header="{loc:T grid.size}" Binding="{Binding SizeText}" Width="80"
                                            HeaderStyle="{StaticResource RightHeader}" CellStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{loc:T journal.col.date}" Binding="{Binding DateText}" Width="120" />
                        <DataGridTemplateColumn Header="" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{loc:T journal.undo}" Padding="8,1" Margin="0,1"
                                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:T journal.col.source}" Binding="{Binding Source}" Width="320" />
                        <DataGridTextColumn Header="{loc:T journal.col.target}" Binding="{Binding Target}" Width="360" />
                        <DataGridTextColumn Header="{loc:T xlsx.message}" Binding="{Binding Message}" Width="600" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </Grid>


        <!-- ================================================ Startbildschirm
             Solange nichts gescannt ist: Laufwerkskarten mit Fuellring statt leerer Flaechen. -->
        <Grid Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg0}" Panel.ZIndex="10"
              Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}">
            <Ellipse Width="1100" Height="700" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,-380,0,0" Fill="{DynamicResource AmbientGlow}" IsHitTestVisible="False" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1420" Margin="56,84,56,48" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:T start.title}" Style="{StaticResource Display}" FontSize="48" />
                    <TextBlock Margin="0,10,0,40" FontSize="16.5" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap" MaxWidth="860"
                               HorizontalAlignment="Left"
                               Text="{loc:T start.text}" />

                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveCard}">
                                <Button Style="{StaticResource CardButton}" Width="450" Margin="0,0,24,24"
                                        Command="{Binding DataContext.ScanPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Root}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="132" Height="132">
                                            <controls:UsageRing x:Name="Ring" Target="{Binding UsedShare}" Delay="{Binding Delay}"
                                                                Thickness="11" FillBrush="{DynamicResource AccentGradient}" TrackBrush="{DynamicResource RingTrack}" />
                                            <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="SemiBold" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                <TextBlock Text="{Binding Letter}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontSize="32" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgDim}" FontSize="14" Margin="0,2,0,12" />
                                            <TextBlock Text="{Binding UsedText}" FontSize="13.5" />
                                            <TextBlock x:Name="FreeLabel" Text="{Binding FreeText}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ColdCold}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTight}" Value="True">
                                        <Setter TargetName="Ring" Property="FillBrush" Value="{DynamicResource WarningGradient}" />
                                        <Setter TargetName="FreeLabel" Property="Foreground" Value="{DynamicResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                        <Setter TargetName="Ring" Property="FillBrush" Value="{DynamicResource DangerGradient}" />
                                        <Setter TargetName="FreeLabel" Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:T start.recent}" Style="{StaticResource Heading}" FontSize="15" Margin="0,24,0,12" />
                    <ItemsControl ItemsSource="{Binding RecentRoots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,8" Padding="12,6"
                                        Command="{Binding DataContext.ScanPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BrowseCommand}" Padding="18,9"
                            HorizontalAlignment="Left" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{loc:T start.otherFolder}" Foreground="White" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================ Scan laeuft
             Grosse Live-Anzeige statt einer Textzeile: drehender Ring, Zaehler, aktueller Pfad. -->
        <Grid Grid.Row="2" Grid.RowSpan="3" Background="{DynamicResource Bg0}" Panel.ZIndex="10"
              Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <Ellipse Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{DynamicResource AmbientGlow}" IsHitTestVisible="False" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="160" Height="160" HorizontalAlignment="Center">
                    <controls:UsageRing Target="1" Thickness="5" FillBrush="#224F7CFF" TrackBrush="Transparent" />
                    <controls:UsageRing Target="0.3" Thickness="5" FillBrush="{DynamicResource AccentGradient}"
                                        TrackBrush="Transparent" RenderTransformOrigin="0.5,0.5">
                        <controls:UsageRing.RenderTransform>
                            <RotateTransform />
                        </controls:UsageRing.RenderTransform>
                        <controls:UsageRing.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </controls:UsageRing.Triggers>
                    </controls:UsageRing>
                    <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{loc:T scan.scanning}" Style="{StaticResource Display}" HorizontalAlignment="Center" Margin="0,26,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <StackPanel Margin="22,0" MinWidth="130">
                        <TextBlock Text="{Binding ScanEntriesText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:T scan.entries}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="22,0" MinWidth="130">
                        <TextBlock Text="{Binding ScanBytesText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentGradient}" />
                        <TextBlock Text="{loc:T scan.found}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="22,0" MinWidth="130">
                        <TextBlock Text="{Binding ScanRateText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:T scan.perSecond}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding ScanCurrentPath}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource FgFaint}"
                           HorizontalAlignment="Center" MaxWidth="720" TextTrimming="CharacterEllipsis" Margin="0,22,0,0" />

                <Button Content="{loc:T common.cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Center"
                        Margin="0,24,0,0" Padding="18,7" />
            </StackPanel>
        </Grid>

        <!-- ================================================ Kacheldiagramm -->
        <GridSplitter Grid.Row="3" x:Name="TreemapSplitter" Height="5" Width="Auto"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource BorderBrush}" />

        <Border Grid.Row="4" x:Name="TreemapPane" Background="{DynamicResource Bg0}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource Bg2}" Padding="12,5"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T treemap.title}" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                            <Button Content="{loc:T treemap.up}" Click="TreemapUp_Click" Padding="9,2" Margin="14,0,0,0" />

                            <TextBlock Text="{loc:T treemap.levels}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="18,0,6,0" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="TreemapDepth" Content="2" Tag="2" Checked="TreemapDepth_Checked" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="TreemapDepth" Content="3" Tag="3" Checked="TreemapDepth_Checked" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="TreemapDepth" Content="4" Tag="4" Checked="TreemapDepth_Checked" IsChecked="True" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="TreemapDepth" Content="6" Tag="6" Checked="TreemapDepth_Checked" />

                            <TextBlock Text="{loc:T treemap.colorBy}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="18,0,6,0" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="TreemapColor" Content="{loc:T treemap.lastUse}" Tag="Alter"
                                         Checked="TreemapColor_Checked" IsChecked="True" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="TreemapColor" Content="{loc:T treemap.fileType}" Tag="Dateityp"
                                         Checked="TreemapColor_Checked" />

                            <ItemsControl x:Name="TreemapLegend" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:TreemapView x:Name="Treemap" Grid.Row="1" Margin="6,6,6,30" />

                <!-- Was unter der Maus liegt -->
                <TextBlock x:Name="TreemapInfo" Grid.Row="1" VerticalAlignment="Bottom" Margin="12,0,12,8"
                           Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis"
                           Text="{loc:T treemap.hint}" />
            </Grid>
        </Border>

        <!-- ================================================ Statuszeile -->
        <Border Grid.Row="5" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgDim}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ExportStatus}" Foreground="{DynamicResource Accent}" Margin="0,0,20,0"
                               Visibility="{Binding HasExportStatus, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{loc:T status.recent}" Foreground="{DynamicResource ColdHot}" Style="{StaticResource Caption}" />
                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                    <TextBlock Text="{loc:T status.longUnused}" Foreground="{DynamicResource ColdFrozen}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
